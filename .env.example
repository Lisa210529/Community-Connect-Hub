# Firebase (optional overrides — defaults work for community-connecthub)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push (FCM) — public key only in client; register pair in Firebase Console → Cloud Messaging
VITE_VAPID_PUBLIC_KEY=

# Set to "true" to use local emulators, or append ?emulators=1 to the URL
VITE_USE_FIREBASE_EMULATORS=false

VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=localhost
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8081
