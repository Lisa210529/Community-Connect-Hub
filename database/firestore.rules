rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasUserProfile() && userProfile().role == 'system-admin';
    }

    function userRole() {
      return userProfile().role;
    }

    function isWdcMember() {
      return hasUserProfile() && userRole() in ['wdc-member', 'wdc_chairman', 'wdc'];
    }

    // Match app-side roleMapping.js (Firestore stores raw role; app normalizes on read)
    function isCouncillor() {
      return hasUserProfile() && (
        userRole() in ['councillor', 'councilor', 'ward_councillor']
        || userProfile().get('rawRole', '') in ['councillor', 'councilor', 'ward_councillor']
      );
    }

    function isAssignedCouncillorForNeed(needId) {
      return isSignedIn()
        && needId is string
        && exists(/databases/$(database)/documents/communityNeeds/$(needId))
        && get(/databases/$(database)/documents/communityNeeds/$(needId)).data.councillorId == request.auth.uid;
    }

    function isProposalAuthor() {
      return isSignedIn()
        && request.resource.data.councillorId == request.auth.uid;
    }

    function isStakeholder() {
      return hasUserProfile() && (
        userRole() in ['psip', 'dsip', 'dda', 'ngo', 'open-member', 'stakeholder']
        || userProfile().get('rawRole', '') in ['psip', 'dsip', 'dda', 'ngo', 'open-member', 'open_member']
        || userProfile().get('userCategory', '') in ['psip', 'dsip', 'dda', 'ngo', 'open-member', 'open_member']
        || userProfile().get('position', '').matches('(?i).*(psip|dsip|dda|ngo|open member|stakeholder).*')
      );
    }

    function stakeholderRoleCandidate() {
      return hasUserProfile()
        ? (
            userProfile().get('rawRole', '') != ''
              ? userProfile().get('rawRole', '')
              : (
                  userProfile().get('userCategory', '') != ''
                    ? userProfile().get('userCategory', '')
                    : userRole()
                )
          )
        : '';
    }

    function assignedStakeholderType() {
      return stakeholderRoleCandidate() == 'open_member'
        ? 'open-member'
        : (
            stakeholderRoleCandidate() in ['psip', 'dsip', 'dda', 'ngo', 'open-member']
              ? stakeholderRoleCandidate()
              : ''
          );
    }

    function canAccessFundingRequest(stakeholderTypeField) {
      return isMayor() || isAdmin() || assignedStakeholderType() == stakeholderTypeField;
    }

    function isStakeholderActingOnFunding() {
      return isSignedIn()
        && request.resource.data.stakeholderId == request.auth.uid
        && request.resource.data.status in ['approved', 'rejected', 'closed'];
    }

    function isStakeholderUpdatingProposal() {
      return isStakeholder()
        && request.resource.data.status in ['funded', 'funding_rejected'];
    }

    function isStakeholderUpdatingCommunityNeed() {
      return isStakeholder()
        && request.resource.data.status == 'funded';
    }

    function isMayor() {
      return hasUserProfile() && (
        userRole() in ['mayor', 'llg_admin', 'llg-admin']
        || userProfile().get('rawRole', '') in ['mayor', 'llg_admin', 'llg-admin']
        || userProfile().get('userCategory', '') in ['mayor', 'llg_admin', 'llg-admin']
        || userProfile().get('position', '').matches('(?i).*(mayor|llg admin|llg_admin).*')
      );
    }

    function isMayorSubmittingFunding() {
      return isSignedIn()
        && request.resource.data.mayorId == request.auth.uid;
    }

    function isMayorEscalatingProposal() {
      return isMayorSubmittingFunding()
        && request.resource.data.status == 'submitted_to_stakeholders';
    }

    function isOfficial() {
      return isAdmin() || isWdcMember() || isCouncillor() || isMayor()
        || (hasUserProfile() && userRole() == 'provincial-admin');
    }

    // Official completes registration: users/{uid} already created with matching NID
    function isOfficialCompletingPreReg() {
      return hasUserProfile()
        && resource.data.isRegistered == false
        && request.resource.data.isRegistered == true
        && userProfile().nid == resource.data.nid;
    }

    function isOwnRegistrationWrite(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.role is string
        && request.resource.data.nid is string;
    }

    // NID registry — read during registration
    match /nids/{nid} {
      allow read: if true;
      allow write: if false;
    }

    // Users collection
    match /users/{userId} {
      // Public read/list for NID and email uniqueness checks during signup
      allow get, list: if true;

      // Create or overwrite own profile during registration (including retry after failed attempt)
      allow create: if isOwnRegistrationWrite(userId);
      allow update: if isOwnRegistrationWrite(userId) || isAdmin();

      // Remove orphaned profiles from failed registration attempts (same NID, different uid)
      allow delete: if isAdmin() || (
        hasUserProfile()
        && request.auth.uid != userId
        && resource.data.nid == userProfile().nid
      );
    }

    // Pre-registered officials
    match /preRegisteredUsers/{docId} {
      // Public read for verification before sign-in
      allow read: if true;
      allow create, delete: if isAdmin();

      // Official marks pre-reg complete after creating users/{uid} with matching NID
      allow update: if isAdmin() || isOfficialCompletingPreReg();
    }

    // Wards
    match /wards/{wardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Projects
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Requests
    match /requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Community needs (WDC forwards grouped resident requests to councillor)
    match /communityNeeds/{needId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOfficial();
      allow update: if isSignedIn() && (
        isOfficial()
        || isMayor()
        || resource.data.councillorId == request.auth.uid
        || (
          request.resource.data.status == 'proposal_submitted_to_mayor'
          && request.resource.data.councillorId == request.auth.uid
          && (!('councillorId' in resource.data) || resource.data.councillorId == null)
        )
        || isMayorEscalatingProposal()
        || isStakeholderUpdatingCommunityNeed()
        || (
          isMayor()
          && request.resource.data.status in ['submitted_to_stakeholders', 'funded']
        )
      );
      allow delete: if isAdmin();
    }

    // In-app notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        isOfficial()
        || isStakeholder()
        || (
          request.resource.data.type == 'proposal_submitted'
          && request.resource.data.communityNeedId is string
          && isAssignedCouncillorForNeed(request.resource.data.communityNeedId)
        )
        || request.resource.data.type in ['funding_approved', 'funding_rejected', 'funding_request']
        || (isMayor() && request.resource.data.type == 'funding_request')
      );
      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // WDC ward reports
    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOfficial();
      allow update: if isSignedIn() && (isOfficial() || isWdcMember());
      allow delete: if isAdmin();
    }

    // Project proposals (councillor submits to mayor)
    match /projectProposals/{proposalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin()
        || isCouncillor()
        || isProposalAuthor()
      );
      allow update: if isSignedIn() && (
        isAdmin()
        || isMayor()
        || isCouncillor()
        || isProposalAuthor()
        || resource.data.councillorId == request.auth.uid
        || isMayorEscalatingProposal()
        || isStakeholderUpdatingProposal()
        || (
          isMayor()
          && request.resource.data.status in ['submitted_to_stakeholders', 'escalated_to_stakeholder', 'funded']
        )
      );
      allow delete: if isAdmin();
    }

    // Funding requests (Mayor escalates → Stakeholder approves/rejects)
    match /fundingRequests/{requestId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || canAccessFundingRequest(resource.data.stakeholderType)
        || resource.data.councillorId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        isMayor()
        || isAdmin()
        || isMayorSubmittingFunding()
      );
      allow update: if isSignedIn() && (
        isAdmin()
        || isMayor()
        || canAccessFundingRequest(resource.data.stakeholderType)
        || isStakeholderActingOnFunding()
      );
      allow delete: if isAdmin();
    }

    // Reference / support letters
    match /letters/{letterId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin()
        || isCouncillor()
        || request.resource.data.councillorId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isAdmin()
        || isCouncillor()
        || resource.data.councillorId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    // Other app collections
    match /{collection}/{document} {
      allow read, write: if isSignedIn()
        && collection in [
          'budgets', 'complaints', 'documents', 'acquittals', 'funding_agencies', 'meetings',
          'ratings', 'resolutions', 'settings', 'wdc_members', 'openMembers'
        ];
    }
  }
}
